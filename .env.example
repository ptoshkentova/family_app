# Token from @BotFather
BOT_TOKEN=
# PostgreSQL connection string
DATABASE_URL=postgres://localhost:5433/budget?sslmode=disable
# HTTP server for the Mini App API and static files
HTTP_ADDR=:8080
# Public HTTPS URL of the Mini App (Telegram requires HTTPS). Leave empty to disable the button.
WEBAPP_URL=
# DEV ONLY: lets a browser outside Telegram call the API as this Telegram user id. Never set in production.
DEV_AUTH_USER_ID=
